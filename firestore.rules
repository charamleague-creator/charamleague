rules_version = '2';

// Convention (see docs/data-modeling-guidelines.md ข้อ 7):
// ทุก write path ต้องเช็ค request.auth != null ร่วมกับ role/ownership เสมอ
// ห้าม `allow write: if true` หรือเทียบเท่าเด็ดขาด — ปัญหาหลักสุดของระบบเดิม

function isSignedIn() {
  return request.auth != null;
}

function hasRole(role) {
  return isSignedIn() && request.auth.token.role == role;
}

function isAdmin() {
  return hasRole('admin');
}

function managesTeam(database, leagueId, teamId) {
  return isSignedIn() &&
    get(/databases/$(database)/documents/leagues/$(leagueId)/teams/$(teamId)).data.managerUid
      == request.auth.uid;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Phase 1: League core — teams/fixtures ทั้งชุดสร้าง/แก้ metadata ได้เฉพาะ admin
    // manager ที่เกี่ยวข้องกับนัดทำได้แค่รายงานสกอร์ (เปลี่ยน scheduled -> played,
    // แก้ได้แค่ field status/homeScore/awayScore) เช็คทั้ง "ใคร" และ "อะไร" ตามข้อ 7
    match /leagues/{leagueId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        // Finance: ย่อยนักเตะ (sellOffPlayer) เป็น self-service ของทีมเจ้าของเอง เพิ่ม balance
        // ให้ตัวเองได้เท่านั้น (field เดียว ทิศทางเดียว) เหมือน guideline เดิมที่ให้ทีมทำ
        // same-team action เองได้ — เงินลด/ลบ/field อื่นๆ ยังเป็นสิทธิ์ admin เท่านั้นเสมอ
        allow update: if isAdmin() || (
          managesTeam(database, leagueId, teamId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']) &&
          request.resource.data.balance > resource.data.balance
        );
        allow create, delete: if isAdmin();

        // Phase 2.1: squad foundation. เพิ่ม/แก้ข้อมูลผู้เล่นยังเป็นสิทธิ์ admin เท่านั้น
        // ลบผู้เล่น (ย่อยนักเตะ/ฉีกสัญญาตอนจบฤดูกาล) ทีมเจ้าของทำเองได้เหมือนเดิม
        match /players/{playerId} {
          allow read: if true;
          allow create, update: if isAdmin();
          allow delete: if isAdmin() || managesTeam(database, leagueId, teamId);
        }

        // Finance: ledger ธุรกรรมของทีม (ย่อยนักเตะ/ภาษีประมูล/ฉีกสัญญา/ปรับมือ) — immutable
        // สร้างได้เฉพาะ admin หรือทีมเจ้าของเอง (คู่กับการอัพเดต balance ข้างบน) ห้ามแก้/ลบ
        match /transactions/{txId} {
          allow read: if true;
          allow create: if isAdmin() || managesTeam(database, leagueId, teamId);
          allow update, delete: if false;
        }
      }

      // Finance: คำขอฉีกสัญญา — คิวรอ ยื่นได้ทุกทีมที่ signed in (admin ก็ยื่นแทนได้)
      // ประมวลผล (เปลี่ยน status) ทำได้เฉพาะ admin ตอนจบฤดูกาลเท่านั้น (เขียนข้ามหลายทีมพร้อมกัน)
      match /tearRequests/{requestId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      // ประวัติการโอนที่สำเร็จแล้ว (ผ่านประมูลเท่านั้น) ใช้คำนวณโควตาสด
      // เขียนได้เฉพาะ admin เพราะเกิดจาก completeSale เท่านั้น ห้ามแก้/ลบ (immutable event log)
      match /transfers/{transferId} {
        allow read: if true;
        allow create: if isAdmin();
        allow update, delete: if false;
      }

      // Phase 2.4: ประมูล — ทีมขายส่งเข้าคิว (pending_approval), แอดมินอนุมัติ/ปฏิเสธ/ปิดประมูล
      // (สร้าง/แก้ status ตอน approve/reject/close เป็นสิทธิ์ admin เท่านั้น ตามที่เอกสารกำหนด)
      // manager ประมูลได้เอง แต่แก้ได้แค่ 3 field ราคา/ผู้ประมูลสูงสุด ตอนสถานะเป็น open เท่านั้น
      // ห้ามประมูลทีมตัวเอง และราคาต้องสูงกว่าราคาปัจจุบันเสมอ (เช็คซ้ำฝั่ง client ด้วย transaction)
      match /auctionListings/{listingId} {
        allow read: if true;
        allow create: if isAdmin() ||
          managesTeam(database, leagueId, request.resource.data.sellerTeamId);
        allow update: if isAdmin() || (
          isSignedIn() &&
          resource.data.status == 'open' &&
          request.resource.data.status == 'open' &&
          request.resource.data.highestBidderTeamId != resource.data.sellerTeamId &&
          managesTeam(database, leagueId, request.resource.data.highestBidderTeamId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['highestBid', 'highestBidderTeamId', 'highestBidderTeamName']) &&
          request.resource.data.highestBid > (
            resource.data.highestBid == null
              ? resource.data.startingPrice - 1
              : resource.data.highestBid
          )
        );
        allow delete: if isAdmin();
      }

      match /matches/{matchId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          isSignedIn() &&
          request.auth.uid in resource.data.involvedManagerUids &&
          resource.data.status == 'scheduled' &&
          request.resource.data.status == 'played' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'homeScore', 'awayScore'])
        );
      }

      // Phase 3: บอลถ้วย — สร้าง bracket + รายงาน/แก้ผลเป็นสิทธิ์ admin ทั้งหมดเสมอ (ต่างจากนัดลีก)
      // เพราะการรายงานผล 1 นัดต้อง propagate ผู้ชนะ + cascade ล้างหลาย document ข้ามคู่ทีมอื่นที่
      // ไม่เกี่ยวกับผู้รายงานเลย (เช่นรอบชิง) ตรวจสิทธิ์ manager ข้ามคู่แบบนี้ปลอดภัยไม่ได้เหมือนตลาดซื้อขาย
      match /cups/{cupId} {
        allow read: if true;
        allow write: if isAdmin();

        match /matches/{cupMatchId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    // Phase 5: หอเกียรติยศ — ผูกกับ manager (ไม่ใช่ทีม) เป็น top-level collection เพราะครอบคลุมทั้งระบบ
    // ไม่ผูกกับลีกใดลีกหนึ่ง เขียนได้เฉพาะ admin (รวมกรอกย้อนหลัง) ห้ามแก้ (แก้ผิดให้ลบสร้างใหม่ เพื่อ
    // ไม่ให้ประวัติ snapshot ถูกเปลี่ยนแบบเงียบๆ) ลบได้เผื่อกรอกผิดจริงๆ
    match /hallOfFame/{entryId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // Phase 6: log กิจกรรมแอดมิน (ข้อ 5.6) — อ่านได้เฉพาะ admin (ไม่ public เพราะเผยรายละเอียดการดำเนินงาน)
    // เขียนได้เฉพาะ admin และต้องเป็นการ log การกระทำของตัวเองเท่านั้น (กัน uid ปลอมว่าเป็นคนอื่นทำ)
    // ห้ามแก้/ลบเด็ดขาด (audit log ที่แก้ได้ก็ไม่มีประโยชน์อะไร)
    match /adminActivityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // deny-by-default: path ที่ไม่ได้ match ข้างบนจะถูกปฏิเสธเสมอ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
