rules_version = '2';

// Convention (see docs/data-modeling-guidelines.md ข้อ 7):
// ทุก write path ต้องเช็ค request.auth != null ร่วมกับ role/ownership เสมอ
// ห้าม `allow write: if true` หรือเทียบเท่าเด็ดขาด — ปัญหาหลักสุดของระบบเดิม

function isSignedIn() {
  return request.auth != null;
}

function hasRole(role) {
  return isSignedIn() && request.auth.token.role == role;
}

function isAdmin() {
  return hasRole('admin');
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ตัวอย่างโครง schema สำหรับ Phase 1 (League core) — ยืนยัน pattern สิทธิ์ผ่าน emulator test
    // ก่อน implement schema จริงของแต่ละฟีเจอร์
    match /leagues/{leagueId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /matches/{matchId} {
        allow read: if true;
        allow create: if isAdmin() ||
          (isSignedIn() && request.auth.uid in request.resource.data.involvedManagerUids);
        allow update: if isAdmin() ||
          (isSignedIn() && request.auth.uid in resource.data.involvedManagerUids);
        allow delete: if isAdmin();
      }
    }

    // deny-by-default: path ที่ไม่ได้ match ข้างบนจะถูกปฏิเสธเสมอ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
